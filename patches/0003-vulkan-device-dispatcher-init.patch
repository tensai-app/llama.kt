diff --git a/llama-kt/src/main/cpp/ggml-vulkan/ggml-vulkan.cpp b/llama-kt/src/main/cpp/ggml-vulkan/ggml-vulkan.cpp
index 29af7a4..599d60c 100644
--- a/llama-kt/src/main/cpp/ggml-vulkan/ggml-vulkan.cpp
+++ b/llama-kt/src/main/cpp/ggml-vulkan/ggml-vulkan.cpp
@@ -6467,2 +6467,17 @@ static vk_device lm_ggml_vk_get_device(size_t idx) {
 
+        // Load device-level function pointers.  On Android/Mali the loader does NOT
+        // return device functions from vkGetInstanceProcAddr — init(instance) only
+        // populates instance-level trampolines.  We must call init(device) here to
+        // populate vkCreateBuffer, vkAllocateMemory, vkMapMemory, etc.
+        VULKAN_HPP_DEFAULT_DISPATCHER.init(device->device);
+
+        // Guard: if vkGetBufferDeviceAddress is not in the dispatch table (e.g. Mali
+        // driver reports bufferDeviceAddress = true in feature struct but does not
+        // expose the function via vkGetDeviceProcAddr), disable the feature to prevent
+        // a null-pointer call inside lm_ggml_vk_create_buffer.
+        if (!VULKAN_HPP_DEFAULT_DISPATCHER.vkGetBufferDeviceAddress) {
+            LM_GGML_LOG_WARN("lm_ggml_vulkan: vkGetBufferDeviceAddress not available — disabling buffer_device_address\n");
+            device->buffer_device_address = false;
+        }
+
         // Queues
