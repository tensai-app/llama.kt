+        // Gated hard, because a K-shift on a cache that cannot shift aborts the
+        // process, and a recurrent state cannot be spliced at all (it still
+        // answers can_shift = true, so can_shift alone is not enough).
+        if (n_past > 0 && !is_enc_dec && !truncated) {
+            auto * kv_reuse = llama_get_memory(parent_ctx->ctx);
+            const size_t n_cmp = std::min(embd.size(), text_tokens.size());
