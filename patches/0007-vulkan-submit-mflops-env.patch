@@ -16600,7 +16619,7 @@ static lm_ggml_status lm_ggml_backend_vk_graph_compute(lm_ggml_backend_t backend
             first_node_in_batch = true;
             submitted_nodes = 0;
             batch_flops = 0;
-            if (submit_count < 3) {
