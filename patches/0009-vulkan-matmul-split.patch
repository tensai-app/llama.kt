+// Tensai: LM_GGML_VK_MATMUL_SPLIT_MFLOPS (MFLOP per dispatch, unset or 0 = off). A prefill matmul is
+// hundreds of ms in one dispatch on a Mali, which only switches between dispatches. When set,
+// lm_ggml_vk_mul_mat_q_f16 cuts big matmuls along M into chunks of about that many MFLOP and submits
+// between them. Parsed once, clamped to 1..1000000 (see tensai_vk_split.h). It also pins the submit
+// budget in graph_compute (unless LM_GGML_VK_SUBMIT_MFLOPS is set), so the queue stays one chunk deep.
+static uint64_t lm_ggml_vk_matmul_split_flops() {
+    static const uint64_t flops = []() -> uint64_t {
+        const uint64_t mflops = tensai_vk::parse_split_mflops(getenv("LM_GGML_VK_MATMUL_SPLIT_MFLOPS"));
+        if (mflops != 0) {
+            LM_GGML_LOG_INFO("vk: matmul split %llu MFLOP\n", (unsigned long long) mflops);
+        }
+        return mflops * 1'000'000ULL;
+    }();
+    return flops;
+}
+
+// Tensai: LM_GGML_VK_MATMUL_SPLIT_SUBMIT=0 keeps all chunks of an op in one command buffer, with no
+// submit and no barrier between them (default 1: submit between chunks). The chunks write disjoint D
+// rows and only read A slices and the same B, and ggml-vulkan barriers are explicit (sync_buffers is a
+// global memory barrier emitted by the ops, not hazard tracking), so none is inserted between the
+// plain split_k == 1 dispatches. The barrier before the next node is the stock one.
+static bool lm_ggml_vk_matmul_split_submit_enabled() {
+    static const bool enabled = tensai_vk::parse_split_submit(getenv("LM_GGML_VK_MATMUL_SPLIT_SUBMIT"));
+    return enabled;
+}
+
+// Close what is recorded so far in subctx (earlier nodes of the batch included) and hand it to the
+// queue, then reopen a command buffer for the rest. The batch's own submit later sends the remainder.
+static void lm_ggml_vk_matmul_split_submit(lm_ggml_backend_vk_context * ctx, vk_context& subctx) {
+    lm_ggml_vk_ctx_end(subctx);
+    // Same staging copies lm_ggml_vk_compute_forward does before a submit; done now, they must not repeat
+    for (auto& cpy : subctx->in_memcpys) {
+        memcpy(cpy.dst, cpy.src, cpy.n);
+    }
+    for (auto& mset : subctx->memsets) {
+        memset(mset.dst, mset.val, mset.n);
+    }
+    subctx->in_memcpys.clear();
+    subctx->memsets.clear();
+    lm_ggml_vk_submit(subctx, {});
+    ctx->submit_pending = true;
+    lm_ggml_vk_ctx_begin(ctx->device, subctx);
+    lm_ggml_vk_sync_buffers(ctx, subctx);
+}
