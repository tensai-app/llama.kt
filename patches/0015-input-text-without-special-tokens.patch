diff --git a/llama-kt/src/main/cpp/rn-completion.h b/llama-kt/src/main/cpp/rn-completion.h
--- a/llama-kt/src/main/cpp/rn-completion.h
+++ b/llama-kt/src/main/cpp/rn-completion.h
@@ -8,6 +8,7 @@
 #include "nlohmann/json.hpp"
 #include "chat.h"
 #include "speculative.h"
+#include "tensai_input_ranges.h"
 #include <atomic>
 #include <deque>
 
@@ -90,6 +91,15 @@
     // llama_decode() failed for a reason other than an abort (nextToken()). Reset by
     // rewind(). Without it a failed decode ended like an EOS and read as a finished reply.
     bool decode_failed = false;
+    // Bytes of params.prompt that came from the messages and hold special-token text
+    // (TEN-218, tensai_input_ranges.h): loadPrompt() tokenizes them as text. Set by
+    // the caller before each loadPrompt(); empty keeps the single tokenize call.
+    std::vector<tensai_input::Range> input_ranges;
+    // The texts of the model's special tokens, the ones the ranges are cut through.
+    // Filled by the caller once per model; special_texts_ready says it was, even when
+    // the vocabulary has none.
+    std::vector<std::string> special_texts;
+    bool special_texts_ready = false;
     std::string prefill_text;
     std::string generated_text;
     std::vector<float> embeddings;
diff --git a/llama-kt/src/main/cpp/rn-completion.cpp b/llama-kt/src/main/cpp/rn-completion.cpp
--- a/llama-kt/src/main/cpp/rn-completion.cpp
+++ b/llama-kt/src/main/cpp/rn-completion.cpp
@@ -488,7 +488,19 @@
         }
 
         // Text-only path - use modified tokenization for encoder-decoder models
-        text_tokens = ::common_tokenize(parent_ctx->ctx, parent_ctx->params.prompt, add_bos || is_enc_dec, true);
+        if (input_ranges.empty()) {
+            text_tokens = ::common_tokenize(parent_ctx->ctx, parent_ctx->params.prompt, add_bos || is_enc_dec, true);
+        } else {
+            // Same BOS/EOS as common_tokenize(add_special) around the pieces.
+            const auto pieces = tensai_input::tokenize(parent_ctx->params.prompt, input_ranges, special_texts,
+                [&](const std::string & piece, bool parse_special) {
+                    return ::common_tokenize(vocab, piece, false, parse_special);
+                });
+            if ((add_bos || is_enc_dec) && llama_vocab_get_add_bos(vocab)) text_tokens.push_back(llama_vocab_bos(vocab));
+            text_tokens.insert(text_tokens.end(), pieces.begin(), pieces.end());
+            if ((add_bos || is_enc_dec) && llama_vocab_get_add_eos(vocab)) text_tokens.push_back(llama_vocab_eos(vocab));
+            LOG_INFO("Input text: %zu range(s) tokenized without special tokens", input_ranges.size());
+        }
         num_prompt_tokens = text_tokens.size();
 
 
